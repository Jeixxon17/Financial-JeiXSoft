rules_version = '2';

// TuPlataAlDia (v2). Publicar en Firebase Console > Firestore > Reglas.
//
// - Cada usuario solo lee y escribe lo suyo: users/{uid} y users/{uid}/…
// - La cuenta anterior del dueño (v1) sigue entrando a las colecciones generales
//   (accounts, transactions…) mientras no actualice su acceso. Después se
//   conservan de respaldo y solo él las puede ver (por su uid).
// Son compatibles con la v1.14: se pueden publicar antes de actualizar el acceso.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Cuenta anterior: correo fijo de la v1
    function isLegacyOwner() {
      return signedIn() && request.auth.token.email == 'owner@financial-jeixsoft.app';
    }

    // El dueño por su uid (sirve también después de cambiar su correo)
    function isOwnerUid() {
      return signedIn()
        && exists(/databases/$(database)/documents/meta/security)
        && get(/databases/$(database)/documents/meta/security).data.uid == request.auth.uid;
    }

    // Público solo para saber si la cuenta anterior ya tiene PIN
    match /meta/security {
      allow read: if true;
      allow write: if isLegacyOwner();
    }

    // Campos que solo escribe el servicio de pagos (con su cuenta de servicio,
    // que no pasa por estas reglas). El usuario no se puede dar el plan solo.
    function touchesPlan() {
      return request.resource.data.diff(resource == null ? {} : resource.data)
        .affectedKeys().hasAny(['plan', 'planInfo']);
    }

    // Perfil de cada usuario (nombre, PIN de bloqueo cifrado, autorizaciones, plan).
    // Lo puede borrar él mismo al eliminar su cuenta (los pagos en payments/ se conservan)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && !touchesPlan();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Datos de cada usuario (solo subcolecciones: con la versión 2 de las reglas,
    // users/{uid}/{document=**} también abarcaría el perfil y dejaría tocar el plan)
    match /users/{uid}/{col}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Datos de la v1 (colecciones generales): solo el dueño
    match /{col}/{docId} {
      allow read, write: if col in ['accounts', 'transactions', 'categories', 'paychecks',
                                    'recurringExpenses', 'pendingTransactions', 'budgets', 'savingsGoals']
        && (isLegacyOwner() || isOwnerUid());
    }
  }
}
